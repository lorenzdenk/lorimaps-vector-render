# All of Tasmania as a vector map: the data and the look of the raster map "tasmania-z17" of lorimaps-render.
# The overlays stay switched on so that the base map leaves out what the walks overlay shows; they are not built
# here: the raster overlays of lorimaps-render fit on top of the vector map.
source "$(dirname "${BASH_SOURCE[0]}")/tasmania-z17.env"
NAME=tasmania
TITLE="Tasmanien"
# check pictures drawn with MapLibre Native at the end: name,lat,lon,level of the app (as in the raster map)
VECTOR_PREVIEW="Uebersicht,-42.0,146.5,8;Hobart,-42.885,147.325,15;Wellington,-42.896,147.237,14;Cradle,-41.68,145.95,13;Cradle,-41.655,145.96,15;Frenchmans,-42.27,145.83,14;Launceston,-41.44,147.14,13;Freycinet,-42.15,148.3,12;Suedwest,-43.2,146.2,11;Lake_StClair,-42.07,146.17,16"
