# small test area for developing the vector pipeline: Hobart and kunanyi / Mount Wellington
# (town, suburbs, mountain with many tracks, coast)
NAME=test-hobart
TITLE="Test Hobart"
BBOX=147.18,-42.96,147.36,-42.84
MINZOOM=0
MAXZOOM=17
MAGNIFY=2
EARLY_TRAILS=2
PBF_URLS="${PBF_URLS:-https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf}"
TASVEG=1
LIST_TRACKS=C
LIST_HILLSHADE=1
LIST_PLUS=1
LIST_HYDRO=1
LIST_CONTOURS=1
