# Render settings. A push that changes files in render/ or vector/ starts the workflow.

# regions to render (one after the other) (files in render/regions/: name, bounding box, zoom levels, OSM sources)
REGIONS="tasmania"
REGION=${REGION:-${REGIONS%% *}}
source "$(dirname "${BASH_SOURCE[0]}")/regions/$REGION.env"

# vector = vector tiles + MapLibre style (this repository's purpose), tiles = raster MBTiles as in lorimaps-render,
# preview = a few images only (fast), profile = render time per map layer (PROFILE_ZOOMS)
PROFILE_ZOOMS="15 17"
MODE=${MODE:-vector}
# vector map: last zoom level of the vector tiles and of the hillshade tiles (512 px), size of lines and text
# relative to OpenTopoMap on 256 px tiles (1.28 = as the raster map in the app), font variant (vector/fonts.json)
VECTOR_MAXZOOM=${VECTOR_MAXZOOM:-14}
HILLSHADE_MAXZOOM=${HILLSHADE_MAXZOOM:-12}
VECTOR_SCALE=${VECTOR_SCALE:-1.28}
VECTOR_FONT=${VECTOR_FONT:-firasans}
# map font (dejavu, noto, roboto, opensans, verdana, trebuchet, helvetica, geometric, swiss)
FONT=trebuchet
# MODE=preview: font variants to compare (one font = overview sheet of all places)
PREVIEW_FONTS=trebuchet
# MODE=preview: places to render: from preview_places.txt or found automatically
# (Zeltplatz, Tor_verschlossen, Pisten, Weg_privat, Pfad_unsichtbar, Aussichtspunkt); empty = all
PREVIEW_PLACES=Pisten,Pisten_4WD,Tor_verschlossen,Trail_Namen_Zoom14
# tile image format: webp:75 (lossy WebP, quality 75; 85 is about a third larger) or png8:m=h (PNG, 256 colours)
TILE_FORMAT=${TILE_FORMAT:-webp:75}
# WebP quality of the base map from zoom HIGH_ZOOM on (these levels are most of the file). Tested on tiles of
# map-43: 60 is not distinguishable from 75 on z16/17 and about 14 % smaller; at 50 thin contour lines lose colour.
HIGH_ZOOM_QUALITY=${HIGH_ZOOM_QUALITY:-60}
HIGH_ZOOM=${HIGH_ZOOM:-16}
# 2 = 512 px tiles ("@2x", sharp on phones)
SCALE=2
# 2 = lines, symbols and labels twice as large (each zoom level shows the content of the next lower one,
# so render one zoom level more for the same detail); 1 = like OpenTopoMap. Can be set per region.
MAGNIFY=${MAGNIFY:-2}
# wilderness only up to this zoom level (the app enlarges it beyond; empty = everything up to MAXZOOM). Can be set
# per region. Wilderness = further than WILD_ROAD_KM from any road and further than WILD_TRAIL_KM from any path or
# track of a day walk (= path within WILD_HIKE_KM of a road, straight line, one way; 0 = every path and track).
WILD_MAXZOOM=${WILD_MAXZOOM:-}
WILD_ROAD_KM=${WILD_ROAD_KM:-2}
WILD_HIKE_KM=${WILD_HIKE_KM:-10}
WILD_TRAIL_KM=${WILD_TRAIL_KM:-1}
# split the tiles into SHARDS parts (set by the GitHub workflow; on the laptop leave 1)
SHARDS=${SHARDS:-1}
# number of parallel GitHub jobs for MODE=tiles (max. 20 at the same time on the free plan)
GITHUB_SHARDS=${GITHUB_SHARDS:-8}
# repository whose releases hold the prepared data (tasveg-data, list-data, hillshade-data, osm-cache)
DATA_REPO=${DATA_REPO:-lorenzdenk/lorimaps-render}
